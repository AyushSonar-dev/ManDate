NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://mandate:mandate@localhost:5432/mandate?schema=public
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox

# Ordered fallback chain. Fallback only happens on HTTP 429/5xx before any tool call.
LLM_CHAIN=gemini:gemini-2.5-flash
# LLM_CHAIN=groq:llama-3.3-70b-versatile,cerebras:llama-3.3-70b,gemini:gemini-2.5-flash
# Optional separate model for the intent check; defaults to the first chain entry.
# INTENT_MODEL=groq:llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_api_key
# GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# GitHub Models token with the Models read-only permission.
# GITHUB_MODELS_TOKEN=your_github_models_token
# LLM_CHAIN=github:openai/gpt-4.1

# Per-provider request budgets. The agent waits instead of sending a request over budget.
# LLM_RPM_GROQ=25
# LLM_RPM_CEREBRAS=25
# LLM_RPM_GEMINI=10
# LLM_RPM_OPENROUTER=20
# GitHub Models free tier defaults to 10 requests per minute.
# LLM_RPM_GITHUB=10

# Legacy Google key alias for Gemini. Prefer GEMINI_API_KEY.
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key
GOOGLE_MODEL=gemini-3.5-flash

# Use "mock" for tests and the red-team suite; "channel3" for the live demo.
STOREFRONT_PROVIDER=mock
# CHANNEL3_API_KEY=your_channel3_api_key
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_CACHE_DIR=.channel3-cache
CHANNEL3_OFFLINE=false
AGENT_MAX_STEPS=5
INTENT_TIMEOUT_MS=5000

APP_BASE_URL=http://localhost:4000
