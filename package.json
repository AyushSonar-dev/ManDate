{
  "name": "mandate-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Spending-authorization layer for AI shopping agents",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mandate/api",
    "dev:api": "npm run dev --workspace @mandate/api",
    "dev:web": "npm run dev --workspace @mandate/web",
    "build": "npm run build --workspace @mandate/api && npm run build --workspace @mandate/web",
    "build:api": "npm run build --workspace @mandate/api",
    "build:web": "npm run build --workspace @mandate/web",
    "start": "npm run start --workspace @mandate/api",
    "test": "npm run test --workspace @mandate/api",
    "typecheck": "npm run typecheck --workspace @mandate/api && npm run typecheck --workspace @mandate/web",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "agent": "tsx apps/api/src/agent/cli.ts",
    "model-check": "tsx scripts/model-check.ts",
    "toolkit:smoke": "tsx scripts/toolkit-smoke.ts",
    "redteam": "tsx apps/api/src/redteam/cli.ts",
    "redteam:generate-heldout": "tsx scripts/generate-redteam-heldout.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.109",
    "@ai-sdk/openai-compatible": "^1.0.63",
    "@paypal/agent-toolkit": "^1.11.0",
    "@prisma/client": "^6.19.3",
    "ai": "^5.0.286",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "prisma": "^6.19.3",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
