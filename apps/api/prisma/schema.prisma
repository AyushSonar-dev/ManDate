generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DecisionVerdict {
  ALLOW
  BLOCK
  REQUIRE_APPROVAL
}

enum OrderStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
}

enum AttackRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Mandate {
  id                          String   @id @default(uuid())
  totalBudgetMinorUnits       Int
  perPurchaseCapMinorUnits    Int
  approvalThresholdMinorUnits Int
  spentMinorUnits             Int      @default(0)
  currency                    String   @db.Char(3)
  allowedMerchants            String[]
  allowedCategories           String[]
  expiresAt                   DateTime
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  decisions  Decision[]
  orders     Order[]
  approvals  Approval[]
  attackRuns AttackRun[]
  agentRuns  AgentRun[]

  @@map("mandates")
}

model AgentRun {
  id          String         @id @default(uuid())
  mandateId   String?
  prompt      String
  status      AgentRunStatus @default(RUNNING)
  result      String?
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?

  mandate   Mandate?   @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  decisions Decision[]

  @@index([mandateId, startedAt])
  @@map("agent_runs")
}

model Decision {
  id             String          @id @default(uuid())
  mandateId      String
  orderId        String?
  runId          String?
  verdict        DecisionVerdict
  reason         String
  toolName       String
  requestPayload Json?
  createdAt      DateTime        @default(now())

  mandate Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  order   Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  run     AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([mandateId, createdAt])
  @@index([orderId])
  @@index([runId])
  @@map("decisions")
}

model Order {
  id               String      @id @default(uuid())
  mandateId        String
  paypalOrderId    String?     @unique
  idempotencyKey   String      @unique
  merchant         String
  category         String
  items            Json
  amountMinorUnits Int
  feeMinorUnits    Int         @default(0)
  currency         String      @db.Char(3)
  status           OrderStatus @default(CREATED)
  approvalLink     String?
  captureId        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  mandate   Mandate    @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  decisions Decision[]
  approvals Approval[]

  @@index([mandateId, createdAt])
  @@map("orders")
}

model Approval {
  id          String         @id @default(uuid())
  mandateId   String
  orderId     String?
  status      ApprovalStatus @default(PENDING)
  reason      String?
  resolvedBy  String?
  requestedAt DateTime       @default(now())
  resolvedAt  DateTime?

  mandate Mandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([mandateId, status])
  @@index([orderId])
  @@map("approvals")
}

model AttackRun {
  id              String          @id @default(uuid())
  mandateId       String?
  name            String
  status          AttackRunStatus @default(PENDING)
  totalScenarios  Int             @default(0)
  passedScenarios Int             @default(0)
  results         Json?
  startedAt       DateTime        @default(now())
  completedAt     DateTime?

  mandate Mandate? @relation(fields: [mandateId], references: [id], onDelete: SetNull)

  @@index([mandateId, startedAt])
  @@map("attack_runs")
}
